# ---- LLM ----
# auto    -> Gemini if GEMINI_API_KEY is set, otherwise the offline engine
# ollama  -> Ollama, local daemon or its hosted -cloud models
# gemini  -> Gemini
# offline -> the deterministic engine, always
#
# "auto" never resolves to Ollama on its own. A running daemon is not consent
# to send client data to it, so pointing this project at Ollama is this line.
# Whatever you choose, a provider failure degrades to the offline engine
# mid-run rather than failing the workflow.
LLM_PROVIDER=ollama

# Requires: ollama pull gpt-oss:120b-cloud   (cloud models need `ollama signin`)
# For a fully local run, use a tag you have pulled, e.g. gpt-oss:20b
OLLAMA_MODEL=gpt-oss:120b-cloud
# OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT_S=120

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Connector mode ----
# mock  -> deterministic fixtures (default, no credentials needed)
# live  -> real API calls using the credentials below
CONNECTOR_MODE=mock

# ---- Meta Ads ----
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ---- Harvest ----
HARVEST_ACCOUNT_ID=
HARVEST_ACCESS_TOKEN=

# ---- Trello ----
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# ---- Slack ----
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#client-reporting

# ---- Governance ----
# Workflows that write to external systems require approval before dispatch.
REQUIRE_HUMAN_APPROVAL=true
