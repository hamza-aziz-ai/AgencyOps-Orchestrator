# ---- LLM ----
# Leave GEMINI_API_KEY unset to run the deterministic offline engine.
# Every workflow, test and demo runs end-to-end without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Connector mode ----
# mock  -> deterministic fixtures (default, no credentials needed)
# live  -> real API calls using the credentials below
CONNECTOR_MODE=mock

# ---- Meta Ads ----
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ---- Harvest ----
HARVEST_ACCOUNT_ID=
HARVEST_ACCESS_TOKEN=

# ---- Trello ----
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# ---- Slack ----
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#client-reporting

# ---- Governance ----
# Workflows that write to external systems require approval before dispatch.
REQUIRE_HUMAN_APPROVAL=true
